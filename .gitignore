# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
**/.venv-*/
**/.work/

# MATLAB files and autosaves
*.mat
*.asv

# Local datasets: keep only the directory placeholder in Git.
/Data/*
!/Data/.gitkeep

# Evaluation privacy policy:
# - Existing public evaluation folders are explicitly allowed.
# - Every other/new evaluation subfolder is private by default. Keep all
#   partner-specific notebooks, scripts, prepared files, and results together
#   inside one such folder (for example Evaluation/<partner>/).
/Evaluation/*/
!/Evaluation/Field/
!/Evaluation/VOC4IAQ/

# Results belong to their individual evaluation folder and are always local.
/Evaluation/**/Results/

# Generated or local parameter sets.
**/*[Pp]arams*.json
**/*[Pp]arameters*.json
**/[Pp]arameter[Ss]ets/
**/[Pp]arameter_[Ss]ets/

# Deployment privacy policy:
# - Root documentation and the harmless example folders remain public.
# - Every real/model-specific subfolder is private by default because scripts,
#   weights, calibration ranges, metrics, and plots can reveal partner data.
/export_int8/*/
!/export_int8/example/
!/export_int8/example/**
/artifacts/*/
!/artifacts/example/
!/artifacts/example/**
