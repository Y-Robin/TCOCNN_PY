# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# MATLAB files and autosaves
*.mat
*.asv

# Local datasets: keep only the directory placeholder in Git.
/Data/*
!/Data/.gitkeep

# Evaluation privacy policy:
# - Existing public evaluation folders are explicitly allowed.
# - Every other/new evaluation subfolder is private by default. Keep all
#   partner-specific notebooks, scripts, prepared files, and results together
#   inside one such folder (for example Evaluation/<partner>/).
/Evaluation/*/
!/Evaluation/Field/
!/Evaluation/VOC4IAQ/

# Results belong to their individual evaluation folder and are always local.
/Evaluation/**/Results/

# Generated or local parameter sets.
**/*[Pp]arams*.json
**/*[Pp]arameters*.json
**/[Pp]arameter[Ss]ets/
**/[Pp]arameter_[Ss]ets/
